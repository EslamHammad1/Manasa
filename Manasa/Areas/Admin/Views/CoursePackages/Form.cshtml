@model CoursePackageFormViewModel
@{
    var editing = Model.Id != 0;
    ViewData["Title"] = editing ? "Edit package" : "Add package";
}
<div class="page-heading"><div><span class="eyebrow">CATALOG</span><h1>@ViewData["Title"]</h1><p>Define the amount and duration of course access.</p></div></div>
<div class="form-panel">
    <form asp-action="@(editing ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="mb-3"><label asp-for="CourseId" class="form-label">Course</label><select asp-for="CourseId" asp-items="Model.Courses" class="form-select"><option value="">Choose a course</option></select><span asp-validation-for="CourseId" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="3"></textarea><span asp-validation-for="Description" class="text-danger"></span></div>
        <div class="row g-3"><div class="col-md-6"><label asp-for="Price" class="form-label"></label><input asp-for="Price" class="form-control" min="0" step="0.01" /><span asp-validation-for="Price" class="text-danger"></span></div><div class="col-md-6"><label asp-for="AccessDurationDays" class="form-label">Access duration (days)</label><input asp-for="AccessDurationDays" class="form-control" /><span asp-validation-for="AccessDurationDays" class="text-danger"></span></div></div>
        <div class="form-check mt-3 mb-4"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Active</label></div>
        <div class="form-actions"><a asp-action="Index" class="btn btn-light">Cancel</a><button class="btn btn-primary">@(editing ? "Save changes" : "Create package")</button></div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
