@model IReadOnlyList<CoursePackage>
@{
    ViewData["Title"] = "Course packages";
    var courseOptions = (SelectList)ViewData["Courses"]!;
}
<div class="page-heading"><div><span class="eyebrow">CATALOG</span><h1>Course packages</h1><p>Set pricing and course access duration.</p></div><a class="btn btn-primary" asp-action="Create">＋ Add package</a></div>
<div class="panel-card">
    <form method="get" class="filter-bar filter-bar-wrap"><input class="form-control" name="search" value="@ViewData["Search"]" placeholder="Search package or course" aria-label="Search packages" /><select class="form-select" name="courseId" asp-items="@courseOptions"><option value="">All courses</option></select><button class="btn btn-outline-secondary">Filter</button></form>
    @if (Model.Count == 0) { <div class="empty-state"><span>◇</span><h3>No packages found</h3><p>Create a package to define price and access duration.</p></div> }
    else
    {
        <div class="table-responsive"><table class="table align-middle admin-table"><thead><tr><th>Package</th><th>Course</th><th>Price</th><th>Access</th><th>Status</th><th></th></tr></thead><tbody>
        @foreach (var package in Model)
        {
            <tr><td><strong>@package.Name</strong><small class="d-block text-muted text-truncate table-description">@(package.Description ?? "No description")</small></td><td>@package.Course.Title</td><td>@package.Price.ToString("C")</td><td>@package.AccessDurationDays days</td><td><span class="status-pill @(package.IsActive ? "status-live" : "status-draft")">@(package.IsActive ? "Active" : "Inactive")</span></td><td class="text-end text-nowrap"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@package.Id">Edit</a><form asp-action="Delete" asp-route-id="@package.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this package?');"><button class="btn btn-sm btn-outline-danger">Delete</button></form></td></tr>
        }
        </tbody></table></div>
    }
</div>
