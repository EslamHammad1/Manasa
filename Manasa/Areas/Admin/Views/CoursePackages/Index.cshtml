@model IReadOnlyList<CoursePackage>
@{
    ViewData["Title"] = T["Course packages"];
    var courseOptions = (SelectList)ViewData["Courses"]!;
    var pageNumber = (int)ViewData["PageNumber"]!;
    var totalPages = (int)ViewData["TotalPages"]!;
    var courseId = ViewData["CourseId"] as int?;
}
<div class="page-heading"><div><span class="eyebrow">@T["CATALOG"]</span><h1>@T["Course packages"]</h1><p>@T["Set pricing and course access duration."]</p></div><a class="btn btn-primary" asp-action="Create">＋ @T["Add package"]</a></div>
<div class="panel-card">
    <form method="get" class="filter-bar filter-bar-wrap"><label class="visually-hidden" for="package-search">@T["Search packages"]</label><input class="form-control" id="package-search" name="search" value="@ViewData["Search"]" placeholder="@T["Search package or course"]" /><label class="visually-hidden" for="course-filter">@T["Course"]</label><select class="form-select" id="course-filter" name="courseId" asp-items="@courseOptions"><option value="">@T["All courses"]</option></select><button class="btn btn-outline-secondary">@T["Filter"]</button></form>
    @if (Model.Count == 0)
    {
        <div class="empty-state"><span aria-hidden="true">◇</span><h3>@T["No packages found"]</h3><p>@T["Create a package to define price and access duration."]</p></div>
    }
    else
    {
        <div class="table-responsive"><table class="table align-middle admin-table"><thead><tr><th>@T["Package"]</th><th>@T["Course"]</th><th>@T["Price"]</th><th>@T["Access"]</th><th>@T["Status"]</th><th></th></tr></thead><tbody>
        @foreach (var package in Model)
        {
            <tr><td><strong dir="auto">@package.Name</strong><small class="d-block text-muted text-truncate table-description" dir="auto">@(package.Description ?? T["No description"])</small></td><td dir="auto">@package.Course.Title</td><td dir="ltr">@package.Price.ToString("C")</td><td>@T["{0} days", package.AccessDurationDays]</td><td><span class="status-pill @(package.IsActive ? "status-live" : "status-draft")">@(package.IsActive ? T["Active"] : T["Inactive"])</span></td><td class="text-end text-nowrap"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@package.Id">@T["Edit"]</a><form asp-action="Delete" asp-route-id="@package.Id" method="post" class="d-inline" onsubmit="return confirm('@T["Delete this package?"]');"><button class="btn btn-sm btn-outline-danger">@T["Delete"]</button></form></td></tr>
        }
        </tbody></table></div>
        @if (totalPages > 0)
        {
            <nav aria-label="@T["Page {0} of {1}", pageNumber, totalPages]" class="mt-3"><ul class="pagination pagination-sm mb-0">
                <li class="page-item @(pageNumber == 1 ? "disabled" : "")">
                    @if (pageNumber > 1) { <a class="page-link" asp-action="Index" asp-route-search="@ViewData["Search"]" asp-route-courseId="@courseId" asp-route-page="@(pageNumber - 1)">@T["Previous"]</a> }
                    else { <span class="page-link" aria-disabled="true">@T["Previous"]</span> }
                </li>
                <li class="page-item disabled"><span class="page-link">@T["Page {0} of {1}", pageNumber, totalPages]</span></li>
                <li class="page-item @(pageNumber == totalPages ? "disabled" : "")">
                    @if (pageNumber < totalPages) { <a class="page-link" asp-action="Index" asp-route-search="@ViewData["Search"]" asp-route-courseId="@courseId" asp-route-page="@(pageNumber + 1)">@T["Next"]</a> }
                    else { <span class="page-link" aria-disabled="true">@T["Next"]</span> }
                </li>
            </ul></nav>
        }
    }
</div>
