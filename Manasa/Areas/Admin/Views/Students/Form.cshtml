@model StudentFormViewModel
@{
    var editing = !string.IsNullOrEmpty(Model.UserId);
    ViewData["Title"] = editing ? T["Edit student"] : T["Add student"];
}
<div class="page-heading"><div><span class="eyebrow">@T["PEOPLE"]</span><h1>@ViewData["Title"]</h1><p>@(editing ? T["Update student account details."] : T["A unique student username will be generated automatically."])</p></div></div>
<div class="form-panel">
    <form asp-action="@(editing ? "Edit" : "Create")" asp-route-id="@Model.UserId" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        @if (editing) { <input asp-for="UserId" type="hidden" /><div class="mb-3"><label class="form-label">@T["Username"]</label><input class="form-control" value="@Model.UserName" readonly dir="ltr" /></div> }
        <div class="mb-3"><label asp-for="DisplayName" class="form-label">@T["Full name"]</label><input asp-for="DisplayName" class="form-control" dir="auto" /><span asp-validation-for="DisplayName" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" dir="ltr" /><span asp-validation-for="Email" class="text-danger"></span></div>
        <div class="form-actions"><a asp-action="Index" class="btn btn-light">@T["Cancel"]</a><button class="btn btn-primary">@(editing ? T["Save changes"] : T["Create student"])</button></div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
