@model StudentListViewModel
@{
    ViewData["Title"] = T["Students"];
}
<div class="page-heading"><div><span class="eyebrow">@T["PEOPLE"]</span><h1>@T["Students"]</h1><p>@T["Search accounts and manage student access."]</p></div><a class="btn btn-primary" asp-action="Create">＋ @T["Add student"]</a></div>
@if (TempData["AccountSetupUrl"] is string setupUrl)
{
    <div class="alert alert-info"><strong>@T["Student {0} created.", TempData["CreatedUserName"]?.ToString() ?? string.Empty]</strong> <a href="@setupUrl" class="alert-link" target="_blank" rel="noopener">@T["Open one-time account setup"]</a><div class="small mt-1">@T["Copy the link and share it with the student. It is not sent by email."]</div></div>
}
<div class="panel-card">
    <form method="get" class="filter-bar"><label class="visually-hidden" for="search">@T["Search students"]</label><input class="form-control" id="search" name="search" value="@Model.Search" placeholder="@T["Search username, name, or email"]" /><button class="btn btn-outline-secondary">@T["Search"]</button></form>
    @if (Model.Items.Count == 0)
    {
        <div class="empty-state"><span aria-hidden="true">♧</span><h3>@T["No students found"]</h3><p>@T["Student accounts will appear here when created."]</p></div>
    }
    else
    {
        <div class="table-responsive"><table class="table align-middle admin-table"><thead><tr><th>@T["Username"]</th><th>@T["Student"]</th><th>@T["Email"]</th><th>@T["Status"]</th><th></th></tr></thead><tbody>
        @foreach (var student in Model.Items)
        {
            <tr><td><span class="username-chip" dir="ltr">@student.UserName</span></td><td dir="auto">@(student.DisplayName ?? "—")</td><td dir="ltr">@(student.Email ?? "—")</td><td><span class="status-pill @(student.IsActive ? "status-live" : "status-draft")">@(student.IsActive ? T["Active"] : T["Inactive"])</span></td><td class="text-end text-nowrap"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@student.UserId">@T["Edit"]</a><form asp-action="ToggleActive" asp-route-id="@student.UserId" method="post" class="d-inline"><input type="hidden" name="page" value="@Model.PageNumber" /><input type="hidden" name="search" value="@Model.Search" /><button class="btn btn-sm btn-outline-secondary">@(student.IsActive ? T["Deactivate"] : T["Activate"])</button></form></td></tr>
        }
        </tbody></table></div>
        @if (Model.TotalPages > 1)
        {
            <nav aria-label="@T["Student pages"]" class="mt-3"><ul class="pagination pagination-sm mb-0">
            @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
            {
                <li class="page-item @(pageNumber == Model.PageNumber ? "active" : "")"><a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-page="@pageNumber">@pageNumber</a></li>
            }
            </ul></nav>
        }
    }
</div>
