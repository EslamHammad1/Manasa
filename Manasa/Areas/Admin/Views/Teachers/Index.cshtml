@model IReadOnlyList<TeacherProfile>
@{
    ViewData["Title"] = T["Teachers"];
    var pageNumber = (int)ViewData["PageNumber"]!;
    var totalPages = (int)ViewData["TotalPages"]!;
}
<div class="page-heading"><div><span class="eyebrow">@T["PEOPLE"]</span><h1>@T["Teachers"]</h1><p>@T["Manage teacher profiles, subject assignments, and account access."]</p></div><a class="btn btn-primary" asp-action="Create">＋ @T["Add teacher"]</a></div>
@if (TempData["AccountSetupUrl"] is string setupUrl)
{
    <div class="alert alert-info"><strong>@T["One-time setup link:"]</strong> <a href="@setupUrl" class="alert-link" target="_blank" rel="noopener">@T["Open account setup"]</a><div class="small mt-1">@T["Copy this link and share it with the teacher. It is not sent by email."]</div></div>
}
<div class="panel-card">
    <form method="get" class="filter-bar"><label class="visually-hidden" for="search">@T["Search teachers"]</label><input class="form-control" id="search" name="search" value="@ViewData["Search"]" placeholder="@T["Search by name, email, or specialization"]" /><button class="btn btn-outline-secondary">@T["Search"]</button></form>
    @if (Model.Count == 0)
    {
        <div class="empty-state"><span aria-hidden="true">♙</span><h3>@T["No teachers found"]</h3><p>@T["Add a teacher profile and assign subjects."]</p></div>
    }
    else
    {
        <div class="table-responsive"><table class="table align-middle admin-table"><thead><tr><th>@T["Teacher"]</th><th>@T["Specialization"]</th><th>@T["Subjects"]</th><th>@T["Experience"]</th><th>@T["Status"]</th><th></th></tr></thead><tbody>
        @foreach (var teacher in Model)
        {
            <tr>
                <td><div class="teacher-identity">
                    @if (!string.IsNullOrWhiteSpace(teacher.ProfileImageUrl))
                    {
                        <img class="teacher-avatar-image" src="@teacher.ProfileImageUrl" alt="" loading="lazy" onerror="this.hidden=true; this.nextElementSibling.hidden=false" /><span class="teacher-avatar-fallback" hidden>@(teacher.FullName.Length == 0 ? "T" : teacher.FullName[..1].ToUpperInvariant())</span>
                    }
                    else
                    {
                        <span class="teacher-avatar-fallback">@(teacher.FullName.Length == 0 ? "T" : teacher.FullName[..1].ToUpperInvariant())</span>
                    }
                    <span><strong dir="auto">@teacher.FullName</strong><small class="d-block text-muted" dir="ltr">@teacher.User.Email</small></span>
                </div></td>
                <td dir="auto">@(teacher.Specialization ?? "—")</td>
                <td dir="auto">@string.Join(", ", teacher.SubjectTeachers.Select(link => link.Subject.Name))</td>
                <td>@(teacher.ExperienceYears.HasValue ? T["{0} years", teacher.ExperienceYears.Value] : "—")</td>
                <td><span class="status-pill @(teacher.IsActive ? "status-live" : "status-draft")">@(teacher.IsActive ? T["Active"] : T["Inactive"])</span></td>
                <td class="text-end text-nowrap"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@teacher.Id">@T["Edit"]</a><form asp-action="ToggleActive" asp-route-id="@teacher.Id" method="post" class="d-inline"><button class="btn btn-sm btn-outline-secondary">@(teacher.IsActive ? T["Deactivate"] : T["Activate"])</button></form></td>
            </tr>
        }
        </tbody></table></div>
        @if (totalPages > 0)
        {
            <nav aria-label="@T["Page {0} of {1}", pageNumber, totalPages]" class="mt-3"><ul class="pagination pagination-sm mb-0">
                <li class="page-item @(pageNumber == 1 ? "disabled" : "")">
                    @if (pageNumber > 1) { <a class="page-link" asp-action="Index" asp-route-search="@ViewData["Search"]" asp-route-page="@(pageNumber - 1)">@T["Previous"]</a> }
                    else { <span class="page-link" aria-disabled="true">@T["Previous"]</span> }
                </li>
                <li class="page-item disabled"><span class="page-link">@T["Page {0} of {1}", pageNumber, totalPages]</span></li>
                <li class="page-item @(pageNumber == totalPages ? "disabled" : "")">
                    @if (pageNumber < totalPages) { <a class="page-link" asp-action="Index" asp-route-search="@ViewData["Search"]" asp-route-page="@(pageNumber + 1)">@T["Next"]</a> }
                    else { <span class="page-link" aria-disabled="true">@T["Next"]</span> }
                </li>
            </ul></nav>
        }
    }
</div>
