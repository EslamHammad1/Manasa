@model IReadOnlyList<TeacherProfile>
@{
    ViewData["Title"] = "Teachers";
}
<div class="page-heading"><div><span class="eyebrow">PEOPLE</span><h1>Teachers</h1><p>Manage teacher profiles, subject assignments, and account access.</p></div><a class="btn btn-primary" asp-action="Create">＋ Add teacher</a></div>
@if (TempData["AccountSetupUrl"] is string setupUrl)
{
    <div class="alert alert-info"><strong>One-time setup link:</strong> <a href="@setupUrl" class="alert-link" target="_blank" rel="noopener">Open account setup</a><div class="small mt-1">Copy this link and share it with the teacher. It is not sent by email.</div></div>
}
<div class="panel-card">
    <form method="get" class="filter-bar"><label class="visually-hidden" for="search">Search teachers</label><input class="form-control" id="search" name="search" value="@ViewData["Search"]" placeholder="Search by name, email, or specialization" /><button class="btn btn-outline-secondary">Search</button></form>
    @if (Model.Count == 0) { <div class="empty-state"><span>♙</span><h3>No teachers found</h3><p>Add a teacher profile and assign subjects.</p></div> }
    else
    {
        <div class="table-responsive"><table class="table align-middle admin-table"><thead><tr><th>Teacher</th><th>Specialization</th><th>Subjects</th><th>Experience</th><th>Status</th><th></th></tr></thead><tbody>
        @foreach (var teacher in Model)
        {
            <tr><td><strong>@teacher.FullName</strong><small class="d-block text-muted">@teacher.User.Email</small></td><td>@(teacher.Specialization ?? "—")</td><td>@string.Join(", ", teacher.SubjectTeachers.Select(link => link.Subject.Name))</td><td>@(teacher.ExperienceYears.HasValue ? $"{teacher.ExperienceYears} years" : "—")</td><td><span class="status-pill @(teacher.IsActive ? "status-live" : "status-draft")">@(teacher.IsActive ? "Active" : "Inactive")</span></td><td class="text-end text-nowrap"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@teacher.Id">Edit</a><form asp-action="ToggleActive" asp-route-id="@teacher.Id" method="post" class="d-inline"><button class="btn btn-sm btn-outline-secondary">@(teacher.IsActive ? "Deactivate" : "Activate")</button></form></td></tr>
        }
        </tbody></table></div>
    }
</div>
