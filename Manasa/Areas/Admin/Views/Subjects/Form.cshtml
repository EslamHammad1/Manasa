@model SubjectFormViewModel
@{
    var editing = Model.Id != 0;
    ViewData["Title"] = editing ? T["Edit subject"] : T["Add subject"];
}
<div class="page-heading"><div><span class="eyebrow">@T["CATALOG"]</span><h1>@ViewData["Title"]</h1><p>@T["Subject details are used to organize courses and teachers."]</p></div></div>
<div class="form-panel">
    <form asp-action="@(editing ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" dir="auto" /><span asp-validation-for="Name" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="4" dir="auto"></textarea><span asp-validation-for="Description" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="ImageUrl" class="form-label">@T["Image URL"]</label><input asp-for="ImageUrl" class="form-control" dir="ltr" /><span asp-validation-for="ImageUrl" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="DisplayOrder" class="form-label">@T["Display order"]</label><input asp-for="DisplayOrder" class="form-control" /><span asp-validation-for="DisplayOrder" class="text-danger"></span></div>
        <div class="form-check mb-4"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">@T["Active"]</label></div>
        <div class="form-actions"><a asp-action="Index" class="btn btn-light">@T["Cancel"]</a><button class="btn btn-primary">@(editing ? T["Save changes"] : T["Create subject"])</button></div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
