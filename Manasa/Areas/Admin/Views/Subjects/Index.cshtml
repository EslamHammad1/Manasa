@model IReadOnlyList<Subject>
@{
    ViewData["Title"] = "Subjects";
}
<div class="page-heading">
    <div><span class="eyebrow">CATALOG</span><h1>Subjects</h1><p>Organize courses and teacher assignments by subject.</p></div>
    <a class="btn btn-primary" asp-action="Create">＋ Add subject</a>
</div>
<div class="panel-card">
    <form method="get" class="filter-bar"><label class="visually-hidden" for="search">Search subjects</label><input class="form-control" id="search" name="search" value="@ViewData["Search"]" placeholder="Search subjects" /><button class="btn btn-outline-secondary">Search</button></form>
    @if (Model.Count == 0)
    {
        <div class="empty-state"><span>▦</span><h3>No subjects found</h3><p>Add a subject to begin organizing courses.</p><a class="btn btn-primary" asp-action="Create">Add subject</a></div>
    }
    else
    {
        <div class="table-responsive"><table class="table align-middle admin-table"><thead><tr><th>Subject</th><th>Courses</th><th>Teacher assignments</th><th>Order</th><th>Status</th><th></th></tr></thead><tbody>
        @foreach (var subject in Model)
        {
            <tr><td><strong>@subject.Name</strong><small class="d-block text-muted text-truncate table-description">@(subject.Description ?? "No description")</small></td><td>@subject.Courses.Count</td><td>@subject.SubjectTeachers.Count</td><td>@subject.DisplayOrder</td><td><span class="status-pill @(subject.IsActive ? "status-live" : "status-draft")">@(subject.IsActive ? "Active" : "Inactive")</span></td><td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@subject.Id">Edit</a><form asp-action="Delete" asp-route-id="@subject.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this subject?');"><button class="btn btn-sm btn-outline-danger">Delete</button></form></td></tr>
        }
        </tbody></table></div>
    }
</div>
