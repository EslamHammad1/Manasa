@model IReadOnlyList<Subject>
@{
    ViewData["Title"] = T["Subjects"];
    var pageNumber = (int)ViewData["PageNumber"]!;
    var totalPages = (int)ViewData["TotalPages"]!;
}
<div class="page-heading"><div><span class="eyebrow">@T["CATALOG"]</span><h1>@T["Subjects"]</h1><p>@T["Organize courses and teacher assignments by subject."]</p></div><a class="btn btn-primary" asp-action="Create">＋ @T["Add subject"]</a></div>
<div class="panel-card">
    <form method="get" class="filter-bar"><label class="visually-hidden" for="search">@T["Search subjects"]</label><input class="form-control" id="search" name="search" value="@ViewData["Search"]" placeholder="@T["Search subjects"]" /><button class="btn btn-outline-secondary">@T["Search"]</button></form>
    @if (Model.Count == 0)
    {
        <div class="empty-state"><span aria-hidden="true">▦</span><h3>@T["No subjects found"]</h3><p>@T["Add a subject to begin organizing courses."]</p><a class="btn btn-primary" asp-action="Create">@T["Add subject"]</a></div>
    }
    else
    {
        <div class="table-responsive"><table class="table align-middle admin-table"><thead><tr><th>@T["Subject"]</th><th>@T["Courses"]</th><th>@T["Teacher assignments"]</th><th>@T["Order"]</th><th>@T["Status"]</th><th></th></tr></thead><tbody>
        @foreach (var subject in Model)
        {
            <tr><td><strong dir="auto">@subject.Name</strong><small class="d-block text-muted text-truncate table-description" dir="auto">@(subject.Description ?? T["No description"])</small></td><td>@subject.Courses.Count</td><td>@subject.SubjectTeachers.Count</td><td>@subject.DisplayOrder</td><td><span class="status-pill @(subject.IsActive ? "status-live" : "status-draft")">@(subject.IsActive ? T["Active"] : T["Inactive"])</span></td><td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@subject.Id">@T["Edit"]</a><form asp-action="Delete" asp-route-id="@subject.Id" method="post" class="d-inline" onsubmit="return confirm('@T["Delete this subject?"]');"><button class="btn btn-sm btn-outline-danger">@T["Delete"]</button></form></td></tr>
        }
        </tbody></table></div>
        @if (totalPages > 0)
        {
            <nav aria-label="@T["Page {0} of {1}", pageNumber, totalPages]" class="mt-3"><ul class="pagination pagination-sm mb-0">
                <li class="page-item @(pageNumber == 1 ? "disabled" : "")">
                    @if (pageNumber > 1) { <a class="page-link" asp-action="Index" asp-route-search="@ViewData["Search"]" asp-route-page="@(pageNumber - 1)">@T["Previous"]</a> }
                    else { <span class="page-link" aria-disabled="true">@T["Previous"]</span> }
                </li>
                <li class="page-item disabled"><span class="page-link">@T["Page {0} of {1}", pageNumber, totalPages]</span></li>
                <li class="page-item @(pageNumber == totalPages ? "disabled" : "")">
                    @if (pageNumber < totalPages) { <a class="page-link" asp-action="Index" asp-route-search="@ViewData["Search"]" asp-route-page="@(pageNumber + 1)">@T["Next"]</a> }
                    else { <span class="page-link" aria-disabled="true">@T["Next"]</span> }
                </li>
            </ul></nav>
        }
    }
</div>
