@model AdminQuizQuestionsViewModel
@{ ViewData["Title"] = T["Manage questions"]; }
<div class="page-heading"><div><span class="eyebrow">@T["ASSESSMENTS"]</span><h1>@Model.QuizTitle</h1><p>@(Model.IsPublished ? T["Published quizzes are taken offline before questions change."] : T["Add questions, answer choices, and correct answers."])</p></div><a class="btn btn-primary align-self-center" asp-action="Question" asp-route-quizId="@Model.QuizId">@T["Add question"]</a></div>
<div class="d-flex gap-2 mb-3"><a class="btn btn-light" asp-action="Edit" asp-route-id="@Model.QuizId">@T["Edit quiz settings"]</a><a class="btn btn-light" asp-action="Preview" asp-route-id="@Model.QuizId">@T["Preview quiz"]</a><a class="btn btn-light" asp-action="Attempts" asp-route-id="@Model.QuizId">@T["View results"]</a>
<form asp-action="Publish" asp-route-id="@Model.QuizId" method="post"><input type="hidden" name="publish" value="@(!Model.IsPublished)"/><button class="btn @(Model.IsPublished ? "btn-outline-danger" : "btn-success")">@(Model.IsPublished ? T["Unpublish"] : T["Publish"])</button></form></div>
@if (Model.Questions.Count == 0) { <div class="student-empty-state"><h2>@T["No questions yet"]</h2><p>@T["Add at least one valid question before publishing."]</p></div> }
else { <div class="table-responsive form-panel"><table class="table align-middle"><thead><tr><th>@T["Order"]</th><th>@T["Question"]</th><th>@T["Type"]</th><th>@T["Points"]</th><th></th></tr></thead><tbody>
@foreach (var question in Model.Questions) { <tr><td>@question.DisplayOrder</td><td dir="auto">@question.Text</td><td>@T[question.Type]</td><td>@question.Points</td><td class="text-nowrap"><a asp-action="Question" asp-route-quizId="@Model.QuizId" asp-route-id="@question.Id">@T["Edit"]</a> <form class="d-inline" asp-action="DeleteQuestion" method="post" onsubmit="return confirm('@T["Delete this question?"]')"><input type="hidden" name="quizId" value="@Model.QuizId"/><input type="hidden" name="questionId" value="@question.Id"/><button class="btn btn-link text-danger">@T["Delete"]</button></form></td></tr> }
</tbody></table></div> }
