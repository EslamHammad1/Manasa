@model CourseFormViewModel
@{
    var editing = Model.Id != 0;
    ViewData["Title"] = editing ? T["Edit course"] : T["Add course"];
}
<div class="page-heading"><div><span class="eyebrow">@T["CATALOG"]</span><h1>@ViewData["Title"]</h1><p>@T["Assign the course to a subject and an eligible teacher."]</p></div></div>
<div class="form-panel">
    <form asp-action="@(editing ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="mb-3"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" dir="auto" /><span asp-validation-for="Title" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="4" dir="auto"></textarea><span asp-validation-for="Description" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="SubjectId" class="form-label">@T["Subject"]</label><select asp-for="SubjectId" asp-items="Model.Subjects" class="form-select"><option value="">@T["Choose a subject"]</option></select><span asp-validation-for="SubjectId" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="TeacherProfileId" class="form-label">@T["Teacher"]</label><select asp-for="TeacherProfileId" asp-items="Model.Teachers" class="form-select"><option value="">@T["Unassigned"]</option></select><span asp-validation-for="TeacherProfileId" class="text-danger"></span><div class="form-text">@T["The selected teacher must be assigned to the selected subject."]</div></div>
        <div class="mb-3"><label asp-for="ThumbnailUrl" class="form-label">@T["Thumbnail URL"]</label><input asp-for="ThumbnailUrl" class="form-control" dir="ltr" /><span asp-validation-for="ThumbnailUrl" class="text-danger"></span></div>
        <div class="form-check mb-4"><input asp-for="IsPublished" class="form-check-input" /><label asp-for="IsPublished" class="form-check-label">@T["Published"]</label></div>
        <div class="form-actions"><a asp-action="Index" class="btn btn-light">@T["Cancel"]</a><button class="btn btn-primary">@(editing ? T["Save changes"] : T["Create course"])</button></div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
