@model CourseFormViewModel
@{
    var editing = Model.Id != 0;
    ViewData["Title"] = editing ? "Edit course" : "Add course";
}
<div class="page-heading"><div><span class="eyebrow">CATALOG</span><h1>@ViewData["Title"]</h1><p>Assign the course to a subject and an eligible teacher.</p></div></div>
<div class="form-panel">
    <form asp-action="@(editing ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="mb-3"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" /><span asp-validation-for="Title" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="4"></textarea><span asp-validation-for="Description" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="SubjectId" class="form-label">Subject</label><select asp-for="SubjectId" asp-items="Model.Subjects" class="form-select"><option value="">Choose a subject</option></select><span asp-validation-for="SubjectId" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="TeacherProfileId" class="form-label">Teacher</label><select asp-for="TeacherProfileId" asp-items="Model.Teachers" class="form-select"><option value="">Unassigned</option></select><span asp-validation-for="TeacherProfileId" class="text-danger"></span><div class="form-text">The selected teacher must be assigned to the selected subject.</div></div>
        <div class="mb-3"><label asp-for="ThumbnailUrl" class="form-label">Thumbnail URL</label><input asp-for="ThumbnailUrl" class="form-control" /><span asp-validation-for="ThumbnailUrl" class="text-danger"></span></div>
        <div class="form-check mb-4"><input asp-for="IsPublished" class="form-check-input" /><label asp-for="IsPublished" class="form-check-label">Published</label></div>
        <div class="form-actions"><a asp-action="Index" class="btn btn-light">Cancel</a><button class="btn btn-primary">@(editing ? "Save changes" : "Create course")</button></div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
