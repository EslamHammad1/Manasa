@model IReadOnlyList<Course>
@{
    ViewData["Title"] = T["Courses"];
    var subjectOptions = (SelectList)ViewData["Subjects"]!;
    var pageNumber = (int)ViewData["PageNumber"]!;
    var totalPages = (int)ViewData["TotalPages"]!;
    var subjectId = ViewData["SubjectId"] as int?;
    var published = ViewData["Published"] as bool?;
}
<div class="page-heading"><div><span class="eyebrow">@T["CATALOG"]</span><h1>@T["Courses"]</h1><p>@T["Create courses, assign teachers, and control publication."]</p></div><a class="btn btn-primary" asp-action="Create">＋ @T["Add course"]</a></div>
<div class="panel-card">
    <form method="get" class="filter-bar filter-bar-wrap">
        <label class="visually-hidden" for="course-search">@T["Search courses"]</label><input class="form-control" id="course-search" name="search" value="@ViewData["Search"]" placeholder="@T["Search courses"]" />
        <label class="visually-hidden" for="subject-filter">@T["Subject"]</label><select class="form-select" id="subject-filter" name="subjectId" asp-items="@subjectOptions"><option value="">@T["All subjects"]</option></select>
        <label class="visually-hidden" for="published-filter">@T["Status"]</label><select class="form-select" id="published-filter" name="published"><option value="">@T["All statuses"]</option><option value="true" selected="@(ViewData["Published"] as bool? == true)">@T["Published"]</option><option value="false" selected="@(ViewData["Published"] as bool? == false)">@T["Draft"]</option></select>
        <button class="btn btn-outline-secondary">@T["Filter"]</button>
    </form>
    @if (Model.Count == 0)
    {
        <div class="empty-state"><span aria-hidden="true">▤</span><h3>@T["No courses found"]</h3><p>@T["Create a course to start building your catalog."] @T["Create a package to define price and access duration."]</p></div>
    }
    else
    {
        <div class="table-responsive"><table class="table align-middle admin-table"><thead><tr><th>@T["Course"]</th><th>@T["Subject"]</th><th>@T["Teacher"]</th><th>@T["Packages"]</th><th>@T["Status"]</th><th></th></tr></thead><tbody>
        @foreach (var course in Model)
        {
            <tr><td><strong dir="auto">@course.Title</strong><small class="d-block text-muted text-truncate table-description" dir="auto">@(course.Description ?? T["No description"])</small></td><td dir="auto">@course.Subject.Name</td><td dir="auto">@(course.TeacherProfile?.FullName ?? T["Unassigned"])</td><td>@course.Packages.Count</td><td><span class="status-pill @(course.IsPublished ? "status-live" : "status-draft")">@(course.IsPublished ? T["Published"] : T["Draft"])</span></td><td class="text-end text-nowrap"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@course.Id">@T["Edit"]</a><form asp-action="Delete" asp-route-id="@course.Id" method="post" class="d-inline" onsubmit="return confirm('@T["Delete this course?"]');"><button class="btn btn-sm btn-outline-danger">@T["Delete"]</button></form></td></tr>
        }
        </tbody></table></div>
        @if (totalPages > 0)
        {
            <nav aria-label="@T["Page {0} of {1}", pageNumber, totalPages]" class="mt-3"><ul class="pagination pagination-sm mb-0">
                <li class="page-item @(pageNumber == 1 ? "disabled" : "")">
                    @if (pageNumber > 1) { <a class="page-link" asp-action="Index" asp-route-search="@ViewData["Search"]" asp-route-subjectId="@subjectId" asp-route-published="@published" asp-route-page="@(pageNumber - 1)">@T["Previous"]</a> }
                    else { <span class="page-link" aria-disabled="true">@T["Previous"]</span> }
                </li>
                <li class="page-item disabled"><span class="page-link">@T["Page {0} of {1}", pageNumber, totalPages]</span></li>
                <li class="page-item @(pageNumber == totalPages ? "disabled" : "")">
                    @if (pageNumber < totalPages) { <a class="page-link" asp-action="Index" asp-route-search="@ViewData["Search"]" asp-route-subjectId="@subjectId" asp-route-published="@published" asp-route-page="@(pageNumber + 1)">@T["Next"]</a> }
                    else { <span class="page-link" aria-disabled="true">@T["Next"]</span> }
                </li>
            </ul></nav>
        }
    }
</div>
