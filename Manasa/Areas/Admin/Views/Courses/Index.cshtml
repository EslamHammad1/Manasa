@model IReadOnlyList<Course>
@{
    ViewData["Title"] = "Courses";
    var subjectOptions = (SelectList)ViewData["Subjects"]!;
}
<div class="page-heading"><div><span class="eyebrow">CATALOG</span><h1>Courses</h1><p>Create courses, assign teachers, and control publication.</p></div><a class="btn btn-primary" asp-action="Create">＋ Add course</a></div>
<div class="panel-card">
    <form method="get" class="filter-bar filter-bar-wrap">
        <input class="form-control" name="search" value="@ViewData["Search"]" placeholder="Search courses" aria-label="Search courses" />
        <select class="form-select" name="subjectId" asp-items="@subjectOptions"><option value="">All subjects</option></select>
        <select class="form-select" name="published"><option value="">All statuses</option><option value="true" selected="@(ViewData["Published"] as bool? == true)">Published</option><option value="false" selected="@(ViewData["Published"] as bool? == false)">Draft</option></select>
        <button class="btn btn-outline-secondary">Filter</button>
    </form>
    @if (Model.Count == 0) { <div class="empty-state"><span>▤</span><h3>No courses found</h3><p>Add a course to start creating lessons and packages.</p></div> }
    else
    {
        <div class="table-responsive"><table class="table align-middle admin-table"><thead><tr><th>Course</th><th>Subject</th><th>Teacher</th><th>Packages</th><th>Status</th><th></th></tr></thead><tbody>
        @foreach (var course in Model)
        {
            <tr><td><strong>@course.Title</strong><small class="d-block text-muted text-truncate table-description">@(course.Description ?? "No description")</small></td><td>@course.Subject.Name</td><td>@(course.TeacherProfile?.FullName ?? "Unassigned")</td><td>@course.Packages.Count</td><td><span class="status-pill @(course.IsPublished ? "status-live" : "status-draft")">@(course.IsPublished ? "Published" : "Draft")</span></td><td class="text-end text-nowrap"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@course.Id">Edit</a><form asp-action="Delete" asp-route-id="@course.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this course?');"><button class="btn btn-sm btn-outline-danger">Delete</button></form></td></tr>
        }
        </tbody></table></div>
    }
</div>
