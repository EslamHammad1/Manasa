@model Manasa.ViewModels.Student.TakeQuizViewModel
@{ ViewData["Title"] = Model.QuizTitle; }
<div class="student-page"><section class="student-welcome"><span class="eyebrow">@T["QUIZ IN PROGRESS"]</span><h1>@Model.QuizTitle</h1>@if (Model.TimeLimitMinutes is not null) { <p>@T["Time limit: {0} minutes", Model.TimeLimitMinutes]</p> }</section>
<form asp-action="Submit" method="post"><input type="hidden" name="AttemptId" value="@Model.AttemptId"/><div asp-validation-summary="ModelOnly" class="text-danger"></div>
@for (var i = 0; i < Model.Questions.Count; i++) { var question = Model.Questions[i]; <fieldset class="form-panel mb-3"><legend>@question.Order. @question.Text</legend><input type="hidden" name="Answers[@i].QuestionId" value="@question.Id"/>@foreach (var option in question.Options) { <div class="form-check"><input class="form-check-input" type="radio" name="Answers[@i].OptionId" id="option-@question.Id-@option.Id" value="@option.Id"/><label class="form-check-label" for="option-@question.Id-@option.Id" dir="auto">@option.Text</label></div> }</fieldset> }
<button class="btn btn-primary" type="submit">@T["Submit quiz"]</button></form></div>
