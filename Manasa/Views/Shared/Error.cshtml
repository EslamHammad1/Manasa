@model ErrorViewModel
@{
    ViewData["Title"] = T["Something went wrong"];
}

<section class="setup-card status-page">
    <span class="status-page-mark" aria-hidden="true">!</span>
    <span class="eyebrow">@T["REQUEST NOT COMPLETED"]</span>
    <h1>@T["Something went wrong"]</h1>
    <p>@T["The request could not be completed. Please try again or return to the home page."]</p>
    @if (Model.ShowRequestId)
    {
        <p class="request-id">@T["Reference: {0}", Model.RequestId ?? string.Empty]</p>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">@T["Return to home"]</a>
</section>
