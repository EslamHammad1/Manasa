@using System.Globalization
@{
    var currentUiCulture = CultureInfo.CurrentUICulture;
    var currentPageUrl = $"{Context.Request.PathBase}{Context.Request.Path}{Context.Request.QueryString}";
    var bootstrapCss = currentUiCulture.TextInfo.IsRightToLeft
        ? Url.Content("~/lib/bootstrap/dist/css/bootstrap.rtl.min.css")
        : Url.Content("~/lib/bootstrap/dist/css/bootstrap.min.css");
}
<!DOCTYPE html>
<html lang="@currentUiCulture.TwoLetterISOLanguageName" dir="@(currentUiCulture.TextInfo.IsRightToLeft ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Manasa</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="@bootstrapCss" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Manasa.styles.css" asp-append-version="true" />
</head>
<body class="site-body">
    <a class="visually-hidden-focusable skip-link" href="#main-content">@T["Skip to content"]</a>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg site-navbar">
            <div class="container">
                <a class="navbar-brand site-brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="@T["Manasa home"]">
                    <span class="site-brand-mark" aria-hidden="true">M</span><span dir="ltr">Manasa<small>@T["LEARNING"]</small></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation" aria-controls="mainNavigation"
                        aria-expanded="false" aria-label="@T["Toggle navigation"]">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavigation">
                    <ul class="navbar-nav me-auto site-links">
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">@T["Home"]</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">@T["Privacy"]</a></li>
                        @if (User.IsInRole("Student"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-area="Student" asp-controller="Dashboard" asp-action="Index">@T["Student dashboard"]</a></li>
                            <li class="nav-item"><a class="nav-link" asp-area="Student" asp-controller="Quizzes" asp-action="Index">@T["Available quizzes"]</a></li>
                        }
                        @if (User.IsInRole("Administrator"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">@T["Administration"]</a></li>
                            <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="Quizzes" asp-action="Index">@T["Quizzes"]</a></li>
                        }
                    </ul>
                    <div class="site-account-actions">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <span class="site-user-name" dir="ltr">@User.Identity.Name</span>
                            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-outline-primary btn-sm">@T["Sign out"]</button></form>
                        }
                        else
                        {
                            <a class="site-signin" asp-area="" asp-controller="Account" asp-action="Login">@T["Sign in"]</a>
                            <a class="btn btn-primary btn-sm" asp-area="" asp-controller="Account" asp-action="Register">@T["Create account"]</a>
                        }
                        <div class="site-language" role="group" aria-label="@T["Change language"]">
                            <form asp-area="" asp-controller="Localization" asp-action="SetLanguage" method="post">
                                <input type="hidden" name="culture" value="en" /><input type="hidden" name="returnUrl" value="@currentPageUrl" />
                                <button type="submit" class="@(currentUiCulture.Name.StartsWith("en", StringComparison.OrdinalIgnoreCase) ? "selected" : "")" lang="en" dir="ltr">@T["English"]</button>
                            </form>
                            <form asp-area="" asp-controller="Localization" asp-action="SetLanguage" method="post">
                                <input type="hidden" name="culture" value="ar" /><input type="hidden" name="returnUrl" value="@currentPageUrl" />
                                <button type="submit" class="@(currentUiCulture.Name.StartsWith("ar", StringComparison.OrdinalIgnoreCase) ? "selected" : "")" lang="ar" dir="rtl">@T["Arabic"]</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <main id="main-content" role="main" class="site-main container">
        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="alert alert-danger" role="alert">@errorMessage</div>
        }
        @RenderBody()
    </main>
    <footer class="site-footer">
        <div class="container site-footer-inner">
            <a class="site-footer-brand" asp-area="" asp-controller="Home" asp-action="Index">Manasa</a>
            <span>@T["Learning starts with a next step."]</span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">@T["Privacy"]</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
