@{
    ViewData["Title"] = T["Account ready"];
}
<section class="setup-card status-page">
    <div class="setup-mark" aria-hidden="true">OK</div>
    <span class="eyebrow">@T["ACCOUNT SETUP COMPLETE"]</span>
    <h1>@T["Password saved"]</h1>
    <p>@T["Your password is set. You can now sign in to your account."]</p>
    <a asp-controller="Account" asp-action="Login" class="btn btn-primary w-100">@T["Sign in"]</a>
</section>
