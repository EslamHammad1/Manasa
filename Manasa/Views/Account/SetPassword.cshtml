@model Manasa.ViewModels.Account.SetPasswordViewModel
@{
    ViewData["Title"] = T["Set your password"];
}
<div class="auth-shell">
    <aside class="auth-visual-panel"><img src="~/images/learning-illustration.svg" alt="@T["A learning workspace illustration"]" /><span class="eyebrow">@T["ACCOUNT SETUP"]</span><h2>@T["Learning starts with a next step."]</h2></aside>
    <section class="setup-card auth-form-card">
        <div class="setup-mark">M</div><span class="eyebrow">@T["ACCOUNT SETUP"]</span><h1>@T["Choose your password"]</h1><p>@T["Set a private password to finish activating your Manasa account."]</p>
        <form asp-action="SetPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input asp-for="UserId" type="hidden" /><input asp-for="Token" type="hidden" />
            <div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="new-password" /><span asp-validation-for="Password" class="text-danger"></span></div>
            <div class="mb-4"><label asp-for="ConfirmPassword" class="form-label">@T["Confirm password"]</label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div>
            <button class="btn btn-primary w-100">@T["Set password"]</button>
        </form>
    </section>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
