@model Manasa.ViewModels.Account.SetPasswordViewModel
@{
    ViewData["Title"] = "Set your password";
}
<div class="setup-card">
    <div class="setup-mark">M</div><span class="eyebrow">ACCOUNT SETUP</span><h1>Choose your password</h1><p>Set a private password to finish activating your Manasa account.</p>
    <form asp-action="SetPassword" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input asp-for="UserId" type="hidden" /><input asp-for="Token" type="hidden" />
        <div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="new-password" /><span asp-validation-for="Password" class="text-danger"></span></div>
        <div class="mb-4"><label asp-for="ConfirmPassword" class="form-label">Confirm password</label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div>
        <button class="btn btn-primary w-100">Set password</button>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
